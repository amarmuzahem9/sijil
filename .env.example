# Sijil environment variables. Copy to .env and adjust. NEVER commit .env.
# All example values are synthetic placeholders. On a server every "change-me" MUST be replaced
# (the API refuses to start in staging/production otherwise).
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Mode --------------------------------------------------------------------
# development | test | staging | production
# Leave commented locally: docker-compose.override.yml sets development.
# Compose defaults to production. The server .env sets staging (now) or production (after go-live).
# APP_ENV=staging

# Caddy site address: localhost for local dev, sijil.t3cftth.net on the server.
SITE_ADDRESS=localhost
# Optional host ports for the proxy (if 80/443 are already taken locally).
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Database ----------------------------------------------------------------
POSTGRES_DB=sijil
POSTGRES_USER=sijil
POSTGRES_PASSWORD=change-me
# Must use the same user/password as above.
DATABASE_URL=postgresql+psycopg://sijil:change-me@db:5432/sijil
# Used by pytest only; the test database is dropped and recreated on every run.
TEST_DATABASE_URL=postgresql+psycopg://sijil:change-me@db:5432/sijil_test

# --- Auth --------------------------------------------------------------------
# Access-token signing key: at least 32 random characters in staging/production.
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Keep true. The refresh cookie is Secure; local dev uses https://localhost.
COOKIE_SECURE=true

# Lockout after repeated wrong passwords (feature 001, US4) and per-IP limit.
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
LOGIN_IP_LIMIT=20
LOGIN_IP_WINDOW_MINUTES=15

# --- Bootstrap main admin (used only on the first start, when no main admin exists) ---
SUPERADMIN_PHONE=07700000000
SUPERADMIN_NAME=الأدمن الرئيسي
SUPERADMIN_PASSWORD=change-me

# --- Demo accounts (seed-demo; refused when APP_ENV=production) ---------------
DEMO_MARKETER_PASSWORD=change-me

# --- Network -----------------------------------------------------------------
# X-Forwarded-For is trusted only from these networks (the compose network / Caddy).
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
