# Sijil environment variables. Copy to .env and adjust. NEVER commit .env.
# All example values are synthetic placeholders. On a server every "change-me" MUST be replaced
# (the API refuses to start in staging/production otherwise).
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Mode --------------------------------------------------------------------
# development | test | staging | production
# Leave commented locally: docker-compose.override.yml sets development.
# Compose defaults to production. The server .env sets staging (now) or production (after go-live).
# APP_ENV=staging

# Caddy site address: localhost for local dev, sijil.t3cftth.net on the server.
SITE_ADDRESS=localhost
# Optional host ports for the proxy (if 80/443 are already taken locally).
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Database ----------------------------------------------------------------
POSTGRES_DB=sijil
POSTGRES_USER=sijil
POSTGRES_PASSWORD=change-me
# Must use the same user/password as above.
DATABASE_URL=postgresql+psycopg://sijil:change-me@db:5432/sijil
# Used by pytest only; the test database is dropped and recreated on every run.
TEST_DATABASE_URL=postgresql+psycopg://sijil:change-me@db:5432/sijil_test

# --- Auth --------------------------------------------------------------------
# Access-token signing key: at least 32 random characters in staging/production.
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Keep true. The refresh cookie is Secure; local dev uses https://localhost.
COOKIE_SECURE=true

# Lockout after repeated wrong passwords (feature 001, US4) and per-IP limit.
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
LOGIN_IP_LIMIT=20
LOGIN_IP_WINDOW_MINUTES=15

# --- Bootstrap main admin (used only on the first start, when no main admin exists) ---
SUPERADMIN_PHONE=07700000000
SUPERADMIN_NAME=الأدمن الرئيسي
SUPERADMIN_PASSWORD=change-me

# --- Demo accounts (seed-demo; refused when APP_ENV=production) ---------------
DEMO_MARKETER_PASSWORD=change-me

# --- Server behind Nginx Proxy Manager (staging/production only) --------------
# Docker network of the NPM container; see deploy/server.md. Not needed locally.
# NPM_NETWORK=npm_default

# --- Network -----------------------------------------------------------------
# X-Forwarded-For is trusted only from these networks (the compose network / Caddy).
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# --- Card images (feature 005) ---------------------------------------------------
# Private storage inside the api container (the `uploads` Docker volume). Never under the web root.
UPLOADS_DIR=/data/uploads
# Upload size limit in bytes (5 MB). Images are compressed on the phone first.
MAX_IMAGE_BYTES=5242880

# --- Export files (feature 019) --------------------------------------------------
# Inside the api container (the `exports` Docker volume, api only). Never backed up; removed 24 h
# after a file is ready.
EXPORTS_DIR=/data/exports

# --- Google Maps (feature 005) -----------------------------------------------------
# Maps JavaScript API key. Leave empty to run without the map (GPS still works).
# The key is visible to browsers by design: in the Google Cloud console restrict it to the HTTP
# referrer https://sijil.t3cftth.net/* and to the Maps JavaScript API and Places API (New) only
# (Places powers the «ابحث عن مكان» search bar).
GOOGLE_MAPS_API_KEY=
# Map ID (Google Cloud console > Map Management), required for the draggable pin.
GOOGLE_MAPS_MAP_ID=
# Map centre "lat,lng" used when there is no pin and no device position.
MAP_DEFAULT_CENTER=34.691628, 43.711077

# --- Card reader (feature 006) -----------------------------------------------------
# http = the internal `ocr` service (docker compose); fake = synthetic results without models
# (used by the tests and the e2e stack). The reader has no internet and no published port.
OCR_MODE=http
OCR_URL=http://ocr:8080
# Public copy of the ocr/ folder (AGPL-3.0), shown in «حسابي» → «رخص البرمجيات المفتوحة».
# Empty → the upstream project URL is shown. Publish ocr/ with scripts/publish-ocr.sh.
OCR_SOURCE_URL=https://github.com/amarmuzahem9/sijil-ocr

# --- Phone OTP by WhatsApp (feature 007) -------------------------------------------
# otpiq = the OTPIQ API (https://docs.otpiq.com); fake = in-memory sender (tests and e2e only,
# refused in staging/production). Sijil generates the 6-digit code; OTPIQ only delivers it.
OTP_MODE=otpiq
# Project API key from app.otpiq.com. Never commit a value.
#   sk_dev_...  local/staging: every message goes to the dev phone set in the OTPIQ dashboard
#   sk_live_... production
# Empty → «تحقّق» shows «خدمة التحقق غير مهيّأة»; the rest of the form still works.
OTPIQ_API_KEY=
OTPIQ_BASE_URL=https://api.otpiq.com/api
# Fixed code for OTP_MODE=fake only (e2e). Leave empty everywhere else.
OTP_FAKE_CODE=

# --- Legacy subscribers import (feature 014) ------------------------------------------
# google = download the card images of the old Google Form from their Drive links (the files
# must be shared «لأي شخص لديه الرابط» at import time); fake = generated images (tests, e2e and
# local development; docker-compose.override.yml sets it). fake is refused in staging/production.
DRIVE_MODE=google

# --- Backups (feature 016, deploy/backup.md) -------------------------------------------
# Host folder for the encrypted backups on the server (owner uid 10001, mode 700). Only the
# `backup` service mounts it; api and web never do. Locally a Docker volume is used instead.
# BACKUP_DIR=/var/backups/sijil
# PUBLIC age key (age1…) printed once by `scripts/backup.sh init-key`. It is not a secret: it can
# only encrypt. The private key stays in key.age, protected by the owner's passphrase, which is
# NEVER written here, on the server, or in git.
BACKUP_AGE_RECIPIENT=
# Mount point of the external drive, plugged in by hand for `scripts/backup.sh weekly`.
# Shown read-only on the backup page; it cannot be changed from the app.
BACKUP_EXTERNAL_DIR=
# Nightly backup time, Baghdad (HH:MM).
BACKUP_NIGHTLY_AT=03:00
# A backup does not start if it would leave less free disk space than this (GB).
BACKUP_MIN_FREE_GB=2
